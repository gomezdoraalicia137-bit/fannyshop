generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("CUSTOMER")
  status       String   @default("ACTIVE")
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  auditLogs     AuditLog[]      @relation("AuditActor")
  assignedCodes DigitalCode[]   @relation("CodeAssigner")
  resetTokens   PasswordReset[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String   @default("Sparkles")
  accent      String   @default("blue")
  image       String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  brand        String?
  description  String  @default("")
  terms        String  @default("")
  region       String  @default("Global")
  image        String?
  logo         String?
  accent       String  @default("blue")
  tag          String?
  active       Boolean @default(true)
  featured     Boolean @default(false)
  deliveryInfo String  @default("Entrega digital inmediata en tu cuenta y por correo.")
  salesCount   Int     @default(0)
  categoryId   String

  taxRate        Float?
  marginRate     Float?
  commissionRate Float?
  roundingRule   String?

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  denominations Denomination[]
  codes         DigitalCode[]
  orderItems    OrderItem[]

  @@index([categoryId])
}

model Denomination {
  id        String  @id @default(cuid())
  productId String
  label     String
  faceValue Float
  cost      Float
  active    Boolean @default(true)
  position  Int     @default(0)

  taxRate        Float?
  marginRate     Float?
  commissionRate Float?
  roundingRule   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  codes      DigitalCode[]
  orderItems OrderItem[]

  @@index([productId])
}

model DigitalCode {
  id             String    @id @default(cuid())
  productId      String
  denominationId String
  secret         String
  fingerprint    String    @unique
  status         String    @default("AVAILABLE")
  batch          String?
  note           String?
  orderItemId    String?
  assignedById   String?
  reservedAt     DateTime?
  soldAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  denomination Denomination @relation(fields: [denominationId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  assignedBy   User?        @relation("CodeAssigner", fields: [assignedById], references: [id])

  @@index([productId, denominationId, status])
}

model Order {
  id            String @id @default(cuid())
  reference     String @unique
  userId        String?
  email         String
  fullName      String
  phone         String?
  status        String @default("PENDING")
  paymentStatus String @default("PENDING")
  paymentMethod String @default("MANUAL_TRANSFER")

  subtotal    Float
  taxTotal    Float
  discount    Float  @default(0)
  total       Float
  costTotal   Float  @default(0)
  profitTotal Float  @default(0)
  currency    String @default("USD")

  couponCode      String?
  notes           String?
  pricingSnapshot String  @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  deliveredAt DateTime?
  completedAt DateTime?

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  denominationId String

  productName       String
  denominationLabel String
  quantity          Int

  unitCost       Float
  unitTax        Float
  unitCommission Float
  unitMargin     Float
  unitPrice      Float
  lineTotal      Float

  taxRate        Float
  marginRate     Float
  commissionRate Float
  roundingRule   String

  product      Product       @relation(fields: [productId], references: [id])
  denomination Denomination  @relation(fields: [denominationId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  codes        DigitalCode[]

  @@index([orderId])
}

model Payment {
  id          String   @id @default(cuid())
  reference   String   @unique
  orderId     String
  method      String
  amount      Float
  status      String   @default("PENDING")
  provider    String?
  providerRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("PERCENT")
  value       Float
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  usedCount   Int       @default(0)
  minTotal    Float?
  productIds  String    @default("")
  categoryIds String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model Visita {
  id        String   @id @default(cuid())
  ruta      String
  fecha     DateTime @default(now())
}
